# Base URL of the Edge Mosaic API. Local dev points at the FastAPI dev server;
# in prod (Vercel) set this to the Railway API URL.
VITE_API_URL=http://localhost:8000

# Sentry DSN (public, write-only — safe to commit). Leave UNSET locally so dev
# errors don't ship to Sentry; set it in the Vercel project env to enable
# monitoring on the deployed build.
VITE_SENTRY_DSN=
