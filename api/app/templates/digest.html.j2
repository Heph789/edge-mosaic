<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Edge Mosaic — Digest</title>
<style>
  :root { color-scheme: light dark; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5; max-width: 680px; margin: 0 auto; padding: 32px 20px; color: #1a1a1a;
  }
  header { border-bottom: 2px solid #1a1a1a; padding-bottom: 16px; margin-bottom: 32px; }
  header h1 { margin: 0 0 4px; font-size: 24px; }
  header .meta { color: #666; font-size: 13px; }
  .feeder { margin-bottom: 40px; }
  .feeder > h2 { font-size: 19px; margin: 0 0 12px; }
  .feeder > h2 .count { color: #999; font-weight: normal; font-size: 14px; }
  .long { margin: 0 0 16px; }
  .long h3 { font-size: 16px; margin: 0 0 4px; }
  .long h3 a { color: #0b5cad; text-decoration: none; }
  .long h3 a:hover { text-decoration: underline; }
  .long .excerpt { margin: 0; color: #444; font-size: 14px; }
  .long .date, .short .date { color: #999; font-size: 12px; }
  .shorts { border-top: 1px solid #e5e5e5; padding-top: 12px; margin-top: 16px; }
  .shorts .label { text-transform: uppercase; letter-spacing: .05em; font-size: 11px; color: #999; margin-bottom: 8px; }
  .short { margin: 0 0 10px; font-size: 14px; }
  .short a { color: #0b5cad; text-decoration: none; }
  .short a:hover { text-decoration: underline; }
  .empty { color: #999; font-style: italic; }
  footer { border-top: 1px solid #e5e5e5; margin-top: 40px; padding-top: 16px; color: #999; font-size: 12px; }
  footer a { color: #999; }
</style>
</head>
<body>
<header>
  <h1>Your Edge Mosaic digest</h1>
  <div class="meta">
    {{ window_start.strftime("%b %d") }} – {{ window_end.strftime("%b %d, %Y") }}
  </div>
</header>

{% if not feeders %}
  <p class="empty">Nothing new from the people you follow this period.</p>
{% endif %}

{% for feeder in feeders %}
<section class="feeder">
  <h2>From {{ feeder.name }}
    <span class="count">· {{ feeder.longs|length }} post{{ "" if feeder.longs|length == 1 else "s" }}{% if feeder.shorts %}, {{ feeder.shorts|length }} update{{ "" if feeder.shorts|length == 1 else "s" }}{% endif %}</span>
  </h2>

  {% for item in feeder.longs %}
  <article class="long">
    <h3><a href="{{ item.url }}">{{ item.title or item.url }}</a></h3>
    {% if item.excerpt %}<p class="excerpt">{{ item.excerpt }}</p>{% endif %}
    <div class="date">{{ item.published_at.strftime("%b %d, %Y") }}</div>
  </article>
  {% endfor %}

  {% if feeder.shorts %}
  <div class="shorts">
    <div class="label">Also posted</div>
    {% for item in feeder.shorts %}
    <div class="short">
      {# RSS shorts (blogmarks) carry a title; Bluesky shorts carry text. #}
      <a href="{{ item.url }}">{{ (item.title or item.text) | truncate_words(short_text_chars) }}</a>
      <span class="date">· {{ item.published_at.strftime("%b %d") }}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endfor %}

<footer>
  You're receiving this because you subscribed on Edge Mosaic.
  {% if unsubscribe_url %}<a href="{{ unsubscribe_url }}">Unsubscribe from all digests</a>.{% endif %}
</footer>

</body>
</html>
