# Edge Mosaic API — environment variables.
# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
# All have sensible local defaults in app/config.py — only override what you need.

# --- Database -------------------------------------------------------------------------
# Local dev defaults to SQLite (no value needed). In prod set the Railway Postgres URL;
# `postgres://` / `postgresql://` is auto-normalized to the psycopg3 driver.
# DATABASE_URL=postgresql://user:pass@host:5432/edgemosaic

# --- Email (Slice 4) ------------------------------------------------------------------
# Backend: "console" (default — logs the email, no real delivery) or "resend".
EMAIL_BACKEND=console

# Resend API key — required when EMAIL_BACKEND=resend. Get it from https://resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address — must be on a Resend-verified sending domain (SPF/DKIM/DMARC).
EMAIL_FROM=Edge Mosaic <digest@yourdomain.com>

# --- URLs -----------------------------------------------------------------------------
# SPA origin (magic-link + unsubscribe links point here). Slice 5 sets the real CDN URL.
APP_BASE_URL=http://localhost:5173

# This API's own public origin (split-origin from the SPA) — used for the one-click
# unsubscribe POST target in List-Unsubscribe headers.
API_BASE_URL=http://localhost:8000

# Comma-separated CORS allowlist of SPA origins permitted to call this API. Defaults to
# the local Vite dev server. In prod set this to the Vercel domain (e.g. https://edge-mosaic.vercel.app).
CORS_ORIGINS=http://localhost:5173

# --- Uploaded media (profile + tile images) -------------------------------------------
# Leave ALL of these UNSET locally: with no MEDIA_S3_BUCKET the app uses the local-filesystem
# backend (api/data/media, served at /media). In prod set them to switch to S3-compatible
# object storage (Railway's filesystem is ephemeral + un-writable for our uid, so prod must
# use a bucket). The bucket stays PRIVATE — images are served via short-lived presigned URLs,
# so do NOT enable R2 public access / a public custom domain. Example values are for Cloudflare R2.
# MEDIA_S3_BUCKET=edge-mosaic-media
# MEDIA_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com   # omit for AWS S3
# MEDIA_S3_REGION=auto                                                  # "auto" for R2; real region for S3
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# Presigned-URL lifetime in seconds (default 3600; SigV4 max 604800). Shorter = a leaked
# link dies sooner; long enough to outlast a page session.
# MEDIA_URL_TTL_SECONDS=3600

# --- X / Twitter (paid, metered) ------------------------------------------------------
# Bearer token for the X API v2 (app-only auth). Required for X sources to scrape — set it
# on the Railway api service AND the scrape cron. Leave UNSET locally/in test; without it the
# X adapter raises and those sources fail in isolation (other sources are unaffected).
# X bills per post read (~$0.005/tweet), so the adapter is frugal: resolve handle->id once
# (cached), then pull only tweets newer than the last seen (since_id). See app/adapters/x.py.
X_BEARER_TOKEN=
# X API base URL — override only for a proxy/private endpoint (default below).
# X_API_BASE=https://api.twitter.com/2
# Tweets fetched per request; X requires 5–100 (default 10).
# X_FEED_LIMIT=10

# --- Error monitoring (Sentry) --------------------------------------------------------
# DSN for the API project. Leave UNSET locally so dev/test errors don't ship to Sentry;
# set it in the Railway environment (shared by the web, scrape, and digest processes) to
# enable monitoring. Each process tags its events component=web|scrape|digest.
SENTRY_DSN=

# Deployed environment name shown in Sentry (defaults to "production").
# SENTRY_ENVIRONMENT=production

# Performance-trace sample rate, 0..1 (defaults to 0 = errors only). Raise to sample
# transactions, e.g. 0.1 for 10% of requests.
# SENTRY_TRACES_SAMPLE_RATE=0
