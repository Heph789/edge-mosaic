# Edge Mosaic API — environment variables.
# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
# All have sensible local defaults in app/config.py — only override what you need.

# --- Database -------------------------------------------------------------------------
# Local dev defaults to SQLite (no value needed). In prod set the Railway Postgres URL;
# `postgres://` / `postgresql://` is auto-normalized to the psycopg3 driver.
# DATABASE_URL=postgresql://user:pass@host:5432/edgemosaic

# --- Email (Slice 4) ------------------------------------------------------------------
# Backend: "console" (default — logs the email, no real delivery) or "resend".
EMAIL_BACKEND=console

# Resend API key — required when EMAIL_BACKEND=resend. Get it from https://resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address — must be on a Resend-verified sending domain (SPF/DKIM/DMARC).
EMAIL_FROM=Edge Mosaic <digest@yourdomain.com>

# --- URLs -----------------------------------------------------------------------------
# SPA origin (magic-link + unsubscribe links point here). Slice 5 sets the real CDN URL.
APP_BASE_URL=http://localhost:5173

# This API's own public origin (split-origin from the SPA) — used for the one-click
# unsubscribe POST target in List-Unsubscribe headers.
API_BASE_URL=http://localhost:8000

# Comma-separated CORS allowlist of SPA origins permitted to call this API. Defaults to
# the local Vite dev server. In prod set this to the Vercel domain (e.g. https://edge-mosaic.vercel.app).
CORS_ORIGINS=http://localhost:5173

# --- Error monitoring (Sentry) --------------------------------------------------------
# DSN for the API project. Leave UNSET locally so dev/test errors don't ship to Sentry;
# set it in the Railway environment (shared by the web, scrape, and digest processes) to
# enable monitoring. Each process tags its events component=web|scrape|digest.
SENTRY_DSN=

# Deployed environment name shown in Sentry (defaults to "production").
# SENTRY_ENVIRONMENT=production

# Performance-trace sample rate, 0..1 (defaults to 0 = errors only). Raise to sample
# transactions, e.g. 0.1 for 10% of requests.
# SENTRY_TRACES_SAMPLE_RATE=0
